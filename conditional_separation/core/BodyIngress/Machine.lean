private def nativeCount : Nat := 2035
/-- Fixed source-family embedding; no head/tape change. -/
def old (k : Nat) (s : Fin (CarryWindow.machine k).stateCount) :
    Fin ((CarryWindow.machine k).stateCount+7500+nativeCount) := ⟨s.val,by omega⟩
/-- BODY terminals are the original literal global verdicts; work controls stay distinct. -/
def body (k : Nat) (s : Fin SerializedBody.machine.stateCount) :
    Fin ((CarryWindow.machine k).stateCount+7500+nativeCount) :=
  if s.val=0 then old k (CarryWindow.machine k).accept
  else if s.val=1 then old k (CarryWindow.machine k).reject
  else ⟨(CarryWindow.machine k).stateCount+s.val,by have h:=s.isLt; change s.val<7500 at h; omega⟩
/-- New literal installer controls, whose count is input-independent. -/
def extra (k : Nat) (j : Fin nativeCount) :
    Fin ((CarryWindow.machine k).stateCount+7500+nativeCount) :=
  ⟨(CarryWindow.machine k).stateCount+7500+j.val,by omega⟩
private def liftOld (k : Nat) (a : Fin (CarryWindow.machine k).stateCount × Option Bool × Move) := (old k a.1,a.2)
private def native (k : Nat) (j : Fin nativeCount) (b : Option Bool) :=
  let c:=instruction (3*j.val+(match b with | none => 0 | some false => 1 | some true => 2))
  let target:=c/9
  let q:=if h:target<nativeCount then extra k ⟨target,h⟩
    else if h:target<nativeCount+3 then body k (SerializedBody.entry ⟨target-nativeCount,by omega⟩)
    else old k (CarryWindow.machine k).reject
  (q,(if c/3%3=0 then none else some (decide (c/3%3=2))),
    (if c%3=0 then Move.left else if c%3=1 then Move.stay else Move.right))
private def rows (k : Nat) (s : Fin ((CarryWindow.machine k).stateCount+7500+nativeCount)) (b : Option Bool) :=
  if h:s.val<(CarryWindow.machine k).stateCount then
    let q:Fin (CarryWindow.machine k).stateCount:=⟨s.val,h⟩
    if q=CarryWindow.ready k ∧ b=none then (extra k ⟨0,by decide⟩,none,Move.stay)
    else liftOld k ((CarryWindow.machine k).step q b)
  else if h:s.val<(CarryWindow.machine k).stateCount+7500 then
    let q:Fin SerializedBody.machine.stateCount:=⟨s.val-(CarryWindow.machine k).stateCount,by change _<7500; omega⟩
    let a:=SerializedBody.machine.step q b
    (body k a.1,a.2)
  else native k ⟨s.val-((CarryWindow.machine k).stateCount+7500),by omega⟩ b
private def extend (M : UniformTM)
    (step : Fin (M.stateCount+7500+nativeCount) → Option Bool → Fin (M.stateCount+7500+nativeCount) × Option Bool × Move) : UniformTM where
  stateCount:=M.stateCount+7500+nativeCount
  start:=⟨M.start.val,by omega⟩
  accept:=⟨M.accept.val,by omega⟩
  reject:=⟨M.reject.val,by omega⟩
  accept_ne_reject:=by intro h; apply M.accept_ne_reject; apply Fin.ext; exact congrArg (fun s : Fin (M.stateCount+7500+nativeCount) => s.val) h
  rawStep:=step
/-- Fixed combined executable family. The sole old-row cut is Ready/none. -/
def machine (k : Nat) : UniformTM := extend (CarryWindow.machine k) (rows k)
/-- Whole old configuration embedding on the same dependent tape allocation. -/
def config (k : Nat) {N B : Nat} (c : Config (CarryWindow.machine k).stateCount N B) :
    Config (machine k).stateCount N B := ⟨old k c.state,c.head,c.tape⟩
/-- Whole BODY configuration embedding, including literal verdict identification. -/
def bodyConfig (k : Nat) {N B : Nat} (c : Config SerializedBody.machine.stateCount N B) :
    Config (machine k).stateCount N B := ⟨body k c.state,c.head,c.tape⟩
end BodyIngress
