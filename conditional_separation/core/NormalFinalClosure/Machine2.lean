private def rows2 (k : Nat) (s : Fin (machine k).stateCount) (b : Option Bool) : Fin (machine k).stateCount × Option Bool × Move :=
  let base:=(RawCallerClosure.machine k).stateCount
  if s.val < base then (machine k).rawStep s b
  else
    let c:=instruction2 (3*(s.val-base)+(match b with |none=>0|some false=>1|some true=>2))
    let target:=c/9
    let q:Fin (machine k).stateCount:=if h:target<4715 then
      ⟨base+target,by change base+target<base+4715;omega⟩
      else if target=4715 then (machine k).accept else (machine k).reject
    (q,(if c/3%3=0 then none else some (decide (c/3%3=2))),
      if c%3=0 then .left else if c%3=1 then .stay else .right)
/-- ROM v2 retains the exact finite control, all old raw rows and ENTRY offset of
v1. Only native guard rows are replaced; r is obtained from physical field width. -/
def machine2 (k : Nat) : UniformTM := {machine k with rawStep:=rows2 k}
/-- Whole original raw caller inclusion, same state values, head and tape. -/
def old2 (k : Nat) (s : Fin (RawCallerClosure.machine k).stateCount) : Fin (machine2 k).stateCount := old k s
def config2 (k : Nat) {N B : Nat} (c : Config (RawCallerClosure.machine k).stateCount N B) : Config (machine2 k).stateCount N B :=
  ⟨old2 k c.state,c.head,c.tape⟩
end NormalFinalClosure
