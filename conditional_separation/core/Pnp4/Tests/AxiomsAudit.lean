import Pnp4.Tests.FullPublicSurfaceTests
import Pnp4.Frontier.ContractExpansion.CircuitTreeBridge
import Lean

/-! Direct bridge API surface. Full mirrors elaborate independently; proofs apply
the unchanged originals. This is a finite bridge audit, not an all-corpus claim. -/
namespace Pnp4.Tests.CircuitTreeBridgeSurface

theorem check_fromTree_toTree :
    ∀ {n : Nat} (c : Pnp3.Models.Circuit n), Pnp4.Frontier.ContractExpansion.fromTree (Pnp4.Frontier.ContractExpansion.toTree c) = c :=
  @Pnp4.Frontier.ContractExpansion.fromTree_toTree

theorem check_toTree_fromTree :
    ∀ {n : Nat} (t : Pnp3.Internal.PsubsetPpoly.TM.Encoding.CircuitTree n), Pnp4.Frontier.ContractExpansion.toTree (Pnp4.Frontier.ContractExpansion.fromTree t) = t :=
  @Pnp4.Frontier.ContractExpansion.toTree_fromTree

theorem check_size_toTree :
    ∀ {n : Nat} (c : Pnp3.Models.Circuit n), (Pnp4.Frontier.ContractExpansion.toTree c).size = Pnp3.Models.Circuit.size c :=
  @Pnp4.Frontier.ContractExpansion.size_toTree

theorem check_decodeCircuit_encodeCircuit :
    ∀ (n : Nat) (width : Nat) (h_width : n ≤ 2 ^ width) (c : Pnp3.Models.Circuit n) (d : Nat) (_h_d : Pnp3.Models.Circuit.size c ≤ d) (rest : List Bool), Pnp4.Frontier.ContractExpansion.decodeCircuit n width d (Pnp4.Frontier.ContractExpansion.encodeCircuit width h_width c ++ rest) = some (c, rest) :=
  @Pnp4.Frontier.ContractExpansion.decodeCircuit_encodeCircuit

end Pnp4.Tests.CircuitTreeBridgeSurface

-- Independent elaborator type/arity pins, not new declarations.
#check (@Pnp4.Frontier.ContractExpansion.toTree : ∀ {n : Nat}, Pnp3.Models.Circuit n → Pnp3.Internal.PsubsetPpoly.TM.Encoding.CircuitTree n)
#check (@Pnp4.Frontier.ContractExpansion.fromTree : ∀ {n : Nat}, Pnp3.Internal.PsubsetPpoly.TM.Encoding.CircuitTree n → Pnp3.Models.Circuit n)
#check (@Pnp4.Frontier.ContractExpansion.encodeCircuit : ∀ {n : Nat} (width : Nat), n ≤ 2 ^ width → Pnp3.Models.Circuit n → List Bool)
#check (@Pnp4.Frontier.ContractExpansion.decodeCircuit : ∀ (n : Nat), Nat → Nat → List Bool → Option (Pnp3.Models.Circuit n × List Bool))
#check (@Pnp4.Frontier.ContractExpansion.fromTree_toTree : ∀ {n : Nat} (c : Pnp3.Models.Circuit n), Pnp4.Frontier.ContractExpansion.fromTree (Pnp4.Frontier.ContractExpansion.toTree c) = c)
#check (@Pnp4.Tests.CircuitTreeBridgeSurface.check_fromTree_toTree : ∀ {n : Nat} (c : Pnp3.Models.Circuit n), Pnp4.Frontier.ContractExpansion.fromTree (Pnp4.Frontier.ContractExpansion.toTree c) = c)
#check (@Pnp4.Frontier.ContractExpansion.toTree_fromTree : ∀ {n : Nat} (t : Pnp3.Internal.PsubsetPpoly.TM.Encoding.CircuitTree n), Pnp4.Frontier.ContractExpansion.toTree (Pnp4.Frontier.ContractExpansion.fromTree t) = t)
#check (@Pnp4.Tests.CircuitTreeBridgeSurface.check_toTree_fromTree : ∀ {n : Nat} (t : Pnp3.Internal.PsubsetPpoly.TM.Encoding.CircuitTree n), Pnp4.Frontier.ContractExpansion.toTree (Pnp4.Frontier.ContractExpansion.fromTree t) = t)
#check (@Pnp4.Frontier.ContractExpansion.size_toTree : ∀ {n : Nat} (c : Pnp3.Models.Circuit n), (Pnp4.Frontier.ContractExpansion.toTree c).size = Pnp3.Models.Circuit.size c)
#check (@Pnp4.Tests.CircuitTreeBridgeSurface.check_size_toTree : ∀ {n : Nat} (c : Pnp3.Models.Circuit n), (Pnp4.Frontier.ContractExpansion.toTree c).size = Pnp3.Models.Circuit.size c)
#check (@Pnp4.Frontier.ContractExpansion.decodeCircuit_encodeCircuit : ∀ (n : Nat) (width : Nat) (h_width : n ≤ 2 ^ width) (c : Pnp3.Models.Circuit n) (d : Nat) (_h_d : Pnp3.Models.Circuit.size c ≤ d) (rest : List Bool), Pnp4.Frontier.ContractExpansion.decodeCircuit n width d (Pnp4.Frontier.ContractExpansion.encodeCircuit width h_width c ++ rest) = some (c, rest))
#check (@Pnp4.Tests.CircuitTreeBridgeSurface.check_decodeCircuit_encodeCircuit : ∀ (n : Nat) (width : Nat) (h_width : n ≤ 2 ^ width) (c : Pnp3.Models.Circuit n) (d : Nat) (_h_d : Pnp3.Models.Circuit.size c ≤ d) (rest : List Bool), Pnp4.Frontier.ContractExpansion.decodeCircuit n width d (Pnp4.Frontier.ContractExpansion.encodeCircuit width h_width c ++ rest) = some (c, rest))

open Lean Elab Command in
run_cmd do
  let requested : List Name := [
    ``Pnp4.Frontier.ContractExpansion.toTree,
    ``Pnp4.Frontier.ContractExpansion.fromTree,
    ``Pnp4.Frontier.ContractExpansion.encodeCircuit,
    ``Pnp4.Frontier.ContractExpansion.decodeCircuit,
    ``Pnp4.Frontier.ContractExpansion.fromTree_toTree,
    ``Pnp4.Frontier.ContractExpansion.toTree_fromTree,
    ``Pnp4.Frontier.ContractExpansion.size_toTree,
    ``Pnp4.Frontier.ContractExpansion.decodeCircuit_encodeCircuit,
    ``Pnp4.Tests.CircuitTreeBridgeSurface.check_fromTree_toTree,
    ``Pnp4.Tests.CircuitTreeBridgeSurface.check_toTree_fromTree,
    ``Pnp4.Tests.CircuitTreeBridgeSurface.check_size_toTree,
    ``Pnp4.Tests.CircuitTreeBridgeSurface.check_decodeCircuit_encodeCircuit]
  let allowed : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let env ← getEnv
  for n in requested do
    unless env.contains n do throwError "absent bridge root {n}"
    let axs ← collectAxioms n
    for a in axs do
      unless allowed.contains a do throwError "nonallowed bridge axiom {a} for {n}"
    logInfo m!"[CS_BRIDGE_ROOT] {n}"
    for a in axs do logInfo m!"[CS_BRIDGE_AXIOM] {n} {a}"

#print axioms Pnp4.Frontier.ContractExpansion.toTree
