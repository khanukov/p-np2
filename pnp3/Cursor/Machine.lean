    match b with
    | none => (q k 66,none,.right)
    | some b => (q k 40,some b,.stay)
  else if s.val=66 then
    match b with
    | none => (q k 67,none,.right)
    | some false => (q k 66,some false,.right)
    | some true => (q k 40,some true,.stay)
  else if s.val=67 then
    match b with
    | none => (mReady k ⟨2,by decide⟩,none,.stay)
    | some b => (q k 67,some b,.right)
  else
    let sym := match b with | none => 0 | some false => 1 | some true => 2
    let code := (codes[3*(s.val-64)+sym]?).getD (9*40+3*sym+1)
    (q k (code/9),(if code/3%3=0 then none else some (code/3%3=2)),
      if code%3=0 then .left else if code%3=1 then .stay else .right)
def rows (k : Nat) : Fin (stateCount k) → Option Bool → Fin (stateCount k) × Option Bool × Move := decode k (program k)
theorem prefix_rows (k : Nat) (s : Fin (stateCount k)) (small : s.val < 64)
    (h57 : s.val ≠ 57) (h58 : s.val ≠ 58) (b : Option Bool) :
    rows k s b=(q k (Stream.rows (Stream.q s.val) b).1.val,(Stream.rows (Stream.q s.val) b).2) := by
  simp only [rows,decode,h57,h58,small,↓reduceIte]
@[noinline] def machine (k : Nat) : UniformTM :=
  let codes := program k
  {
  stateCount := stateCount k
  start := q k 0
  accept := q k 39
  reject := q k 40
  accept_ne_reject := by
    apply Fin.ne_of_val_ne
    change 39 % stateCount k ≠ 40 % stateCount k
    rw [Nat.mod_eq_of_lt (by unfold stateCount; omega),Nat.mod_eq_of_lt (by unfold stateCount; omega)]
    decide
  rawStep := decode k codes }
def rawMachine (k : Nat) : UniformTM := FixedRawLengthFence.prefixed.seq (machine k)
def rReady (k : Nat) : Fin (stateCount k) := q k 98
end Cursor
