private def nativeCount : Nat := 4715
private def oldM (k : Nat) : UniformTM := RawCallerClosure.machine k
private def count (k : Nat) : Nat := (oldM k).stateCount+nativeCount
private def liftOld (k : Nat) (s : Fin (oldM k).stateCount) : Fin (count k) :=
  ⟨s.val,by have h:=s.isLt;dsimp only [count];omega⟩
private def native (k : Nat) (s : Fin nativeCount) : Fin (count k) :=
  ⟨(oldM k).stateCount+s.val,by have h:=s.isLt;dsimp only [count];omega⟩
private def code (k : Nat) (s : Fin (count k)) (b : Option Bool) : Fin (count k) × Option Bool × Move :=
  if h:s.val < (oldM k).stateCount then
    let q : Fin (oldM k).stateCount:=⟨s.val,h⟩
    if q=RawCallerClosure.callerState k (PhysicalCallerClosure.rowsDone k) then
      (native k ⟨1,by decide⟩,b,.stay)
    else let a:=(oldM k).step q b; (liftOld k a.1,a.2)
  else
    let i:=s.val-(oldM k).stateCount
    let c:=instruction (3*i+(match b with | none=>0 | some false=>1 | some true=>2))
    let target:=c/9
    let q:=if ht:target<nativeCount then native k ⟨target,ht⟩
      else if target=nativeCount then liftOld k (oldM k).accept else liftOld k (oldM k).reject
    (q,(if c/3%3=0 then none else some (decide (c/3%3=2))),
      if c%3=0 then .left else if c%3=1 then .stay else .right)
/-- Fixed post-rowsDone extension: only the old WORK exit is activated. The
finite ROM reads Option Bool and never receives source length, n, W or a parser result. -/
private def extend (M : UniformTM)
    (rows : Fin (M.stateCount+nativeCount) → Option Bool → Fin (M.stateCount+nativeCount) × Option Bool × Move) : UniformTM where
  stateCount:=M.stateCount+nativeCount
  start:=⟨M.start.val,by have h:=M.start.isLt;omega⟩
  accept:=⟨M.accept.val,by have h:=M.accept.isLt;omega⟩
  reject:=⟨M.reject.val,by have h:=M.reject.isLt;omega⟩
  accept_ne_reject:=by
    intro h;apply M.accept_ne_reject;apply Fin.ext
    exact congrArg (fun q : Fin (M.stateCount+nativeCount)=>q.val) h
  rawStep:=rows
def machine (k : Nat) : UniformTM := extend (oldM k) (code k)
/-- Literal control inclusion of the entire immutable raw caller. -/
def old (k : Nat) (s : Fin (RawCallerClosure.machine k).stateCount) : Fin (machine k).stateCount := liftOld k s
/-- Whole finite tape and head inclusion, with unchanged allocation. -/
def config (k : Nat) {N B : Nat} (c : Config (RawCallerClosure.machine k).stateCount N B) : Config (machine k).stateCount N B :=
  ⟨old k c.state,c.head,c.tape⟩
end NormalFinalClosure
