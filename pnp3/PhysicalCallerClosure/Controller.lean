private def nativeCount : Nat := 3337
private def count (k : Nat) : Nat := (BodyIngress.machine k).stateCount+7500+nativeCount
private def liftOld (k : Nat) (s : Fin (BodyIngress.machine k).stateCount) : Fin (count k) :=
  ⟨s.val,by have h:=s.isLt;dsimp only [count];omega⟩
private def liftEval (k : Nat) (s : Fin SerializedBody.machine.stateCount) : Fin (count k) :=
  ⟨(BodyIngress.machine k).stateCount+s.val,by have h:=s.isLt;change s.val<7500 at h;dsimp only [count];omega⟩
private def native (k : Nat) (s : Fin nativeCount) : Fin (count k) :=
  ⟨(BodyIngress.machine k).stateCount+7500+s.val,by have h:=s.isLt;dsimp only [count];omega⟩
private def nativeRows (k : Nat) (s : Fin nativeCount) (b : Option Bool) : Fin (count k) × Option Bool × Move :=
  let c:=instruction (3*s.val+(match b with | none=>0 | some false=>1 | some true=>2))
  let target:=c/9
  let q:=if h:target<nativeCount then native k ⟨target,h⟩
    else if h:target<nativeCount+3 then liftEval k (SerializedBody.entry ⟨target-nativeCount,by omega⟩)
    else liftOld k (BodyIngress.machine k).reject
  (q,(if c/3%3=0 then none else some (decide (c/3%3=2))),
    if c%3=0 then .left else if c%3=1 then .stay else .right)
private def rows (k : Nat) (s : Fin (count k)) (b : Option Bool) : Fin (count k) × Option Bool × Move :=
  if h:s.val<(BodyIngress.machine k).stateCount then
    let q:Fin (BodyIngress.machine k).stateCount:=⟨s.val,h⟩
    if q=BodyIngress.body k (SerializedBody.entry ⟨0,by decide⟩) then
      (native k ⟨7,by decide⟩,b,.stay)
    else if q=BodyIngress.body k (SerializedBody.entry ⟨1,by decide⟩) then
      (native k ⟨964,by decide⟩,b,.stay)
    else if q=BodyIngress.body k (SerializedBody.entry ⟨2,by decide⟩) then
      (native k ⟨973,by decide⟩,b,.stay)
    else let a:=(BodyIngress.machine k).step q b; (liftOld k a.1,a.2)
  else if h:s.val<(BodyIngress.machine k).stateCount+7500 then
    let q:Fin SerializedBody.machine.stateCount:=⟨s.val-(BodyIngress.machine k).stateCount,by change _<7500;omega⟩
    if q.val=0 then (liftOld k (BodyIngress.machine k).reject,b,.stay)
    else if q.val=1 then (native k ⟨3334,by decide⟩,b,.stay)
    else if q.val=2 then (native k ⟨2714,by decide⟩,b,.stay)
    else if q.val=3 then (native k ⟨3211,by decide⟩,b,.stay)
    else let a:=SerializedBody.machine.step q b; (liftEval k a.1,a.2)
  else nativeRows k ⟨s.val-((BodyIngress.machine k).stateCount+7500),by have bound:=s.isLt;dsimp only [count]at bound;omega⟩ b
/-- Experimental fixed finite caller: three old entry cuts, one unchanged BODY copy
before its first terminal, and a literal reset/comparison/paid-row ROM. No raw correctness
or all-rows proof is implicit in this definition. -/
private def extend (M : UniformTM)
    (code : Fin (M.stateCount+7500+nativeCount) → Option Bool → Fin (M.stateCount+7500+nativeCount) × Option Bool × Move) : UniformTM where
  stateCount:=M.stateCount+7500+nativeCount
  start:=⟨M.start.val,by have h:=M.start.isLt;omega⟩
  accept:=⟨M.accept.val,by have h:=M.accept.isLt;omega⟩
  reject:=⟨M.reject.val,by have h:=M.reject.isLt;omega⟩
  accept_ne_reject:=by
    intro h
    apply M.accept_ne_reject
    apply Fin.ext
    exact congrArg (fun s : Fin (M.stateCount+7500+nativeCount)=>s.val) h
  rawStep:=code
def callerMachine (k : Nat) : UniformTM := extend (BodyIngress.machine k) (rows k)
/-- Same-allocation whole old-control embedding; no head or tape change. -/
def oldState (k : Nat) : Fin (BodyIngress.machine k).stateCount → Fin (callerMachine k).stateCount := liftOld k
/-- The single frozen BODY copy, whose four terminal rows are live callbacks. -/
def evalState (k : Nat) : Fin SerializedBody.machine.stateCount → Fin (callerMachine k).stateCount := liftEval k
/-- All-row WORK exit. It is distinct from literal content accept. -/
def rowsDone (k : Nat) : Fin (callerMachine k).stateCount := native k ⟨1432,by decide⟩
end PhysicalCallerClosure
